{
  "coverage": {
    "enabled": true,
    "statements": 80,
    "branches": 75,
    "functions": 80,
    "lines": 80,
    "exclude": [
      "**/*.test.ts",
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/.bun/**"
    ],
    "reporter": [
      "text",
      "json",
      "html",
      "lcov"
    ]
  }
}
