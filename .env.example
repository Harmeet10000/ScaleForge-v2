NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
SERVER_ID=local-dev
LOG_LEVEL=info

# MongoDB
DATABASE=mongodb://localhost:27017/scaleforge_dev
DB_POOL_SIZE=10

# PostgreSQL
POSTGRES_DATABASE_URL=postgres://scaleforge:devpassword@localhost:5432/scaleforge_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=devpassword

# Auth
ACCESS_TOKEN_SECRET=dev-access-secret-must-be-at-least-32-chars
REFRESH_TOKEN_SECRET=dev-refresh-secret-must-be-at-least-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# RabbitMQ
RABBITMQ_URL=amqp://scaleforge:devpassword@localhost:5672

# URLs
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# S3 (leave blank; use localstack or real bucket)
ACCESS_KEY=
SECRET_ACCESS_KEY=
BUCKET_NAME=scaleforge-dev
BUCKET_REGION=us-east-1

# Email (get a test key from resend.com)
RESEND_KEY=re_test_xxxx

# Elasticsearch (optional for dev)
ELASTICSEARCH_HOST=
ELASTICSEARCH_API_KEY=

# Gemini AI (optional for dev)
GEMINI_API_KEY=

# Kafka (optional for dev)
KAFKA_BROKER=
KAFKA_CLIENT_ID=scaleforge-dev
KAFKA_GROUP_ID=scaleforge-dev-group
KAFKA_TOPIC=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=plain
KAFKA_SSL=false

# Notifications (optional for dev)
NOVU_API_KEY=

# Observability (optional for dev)
LOKI_HOST=
SENTRY_DSN=
FLAME_ENABLED=false
