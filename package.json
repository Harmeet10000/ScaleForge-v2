    "source-map-support": "^0.5.21",
    "standardwebhooks": "^1.0.0",
    "superjson": "2.2.2",
    "ts-pattern": "^5.9.0",
    "ua-parser-js": "^2.0.9",
    "undici": "7.22.0",
    "undici-cache-redis": "^1.0.1",
    "undici-oidc-interceptor": "^0.9.0",
    "undici-tls-dispatcher": "^0.3.0",
    "uuid": "^11.1.0",
    "winston-mongodb": "^7.0.1",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@effect/language-service": "^0.83.0",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.18.1",
    "@types/zxcvbn": "^4.4.5",
    "drizzle-kit": "0.31.5",
    "faker": "^6.6.6",
    "glob": "11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "0.34.0",
    "oxlint": "1.49.0",
    "oxlint-tsgolint": "^0.20.0",
    "pdfkit": "^0.18.0",
    "playwright": "^1.60.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "bunx oxfmt --write",
      "bunx oxlint --fix"
    ]
  },
  "config": {
    "unsafe-perm": true
  },
  "engines": {
    "node": ">=24.11.0",
    "bun": ">=1.3.8"
  },
  "private": true,
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "trustedDependencies": [
    "@datadog/pprof",
    "es5-ext",
    "protobufjs"
  ]
}
