    "clinic": "^13.0.0",
    "close-with-grace": "^2.5.0",
    "colorette": "^2.0.20",
    "cors": "^2.8.6",
    "countries-and-timezones": "^3.8.0",
    "date-fns": "4.1.0",
    "dayjs": "^1.11.20",
    "drizzle-orm": "0.44.6",
    "effect": "^4.0.0-beta.74",
    "es-toolkit": "^1.46.0",
    "fast-glob": "3.3.3",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "googleapis": "164.1.0",
    "helmet": "^8.1.0",
    "ioredis": "5.6.1",
