{
  "name": "auth_service_backend",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/Harmeet10000/production-grade-auth-template#readme",
  "bugs": {
    "url": "https://github.com/Harmeet10000/production-grade-auth-template/issues"
  },
  "license": "ISC",
  "author": "Harmeet Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harmeet10000/production-grade-auth-template.git"
  },
  "type": "module",
  "main": "index.js",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "dev": "bun --hot src/app/main.ts",
    "build": "bun run build:clean && bun run build:bundle",
    "build:clean": "rm -rf dist",
    "build:bundle": "bun run scripts/bun-build.js",
    "start": "bun run dist/main.js",
    "swagger": "bun run ./docs/swagger.js",
    "test": "bun test tests/**/*.test.ts",
    "test:watch": "bun test --watch tests/**/*.test.ts",
    "test:coverage": "bun test --coverage tests/**/*.test.ts",
    "test:unit": "bun test tests/unit/**/*.test.ts",
    "test:integration": "bun test tests/integration/**/*.test.ts",
    "test:e2e": "bun test tests/e2e/**/*.test.ts",
    "type-check": "bunx tsc --noEmit",
    "prepare": "husky",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "lint:no-console": "bun run scripts/lint-no-console.ts",
    "format": "bunx oxfmt --write",
    "format:check": "bunx oxfmt --check",
    "check": "bun run type-check && bun run lint && bun run format:check && bun run check:layers",
    "check:layers": "bun run scripts/check-layers.ts",
    "check:layers:strict": "bun run scripts/check-layers.ts --strict",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "db:check": "bunx drizzle-kit check",
    "migrate:gen": "bunx drizzle-kit generate",
    "migrate:exec": "bun run src/db/migrate.ts",
    "seed": "bun run src/db/seeders/index.ts",
    "studio": "bunx drizzle-kit studio",
    "mig:push": "bunx drizzle-kit push",
    "mig:drop": "bunx drizzle-kit drop",
    "load:baseline": "k6 run tests/load/k6/scenarios/baseline.js",
    "load:load": "k6 run tests/load/k6/scenarios/load.js",
    "load:stress": "k6 run tests/load/k6/scenarios/stress.js",
    "load:spike": "k6 run tests/load/k6/scenarios/spike.js",
    "sdk:export": "bun run scripts/exportOpenApiSpec.ts --out sdk/openapi.json",
    "sdk:generate": "bun run sdk:export && cd sdk && bun run generate",
    "backup:start": "bun run scripts/dbBackup.js",
    "backup:once": "RUN_BACKUP_ONCE=true bun run scripts/dbBackup.js",
    "security:test": "bunx snyk test",
    "security:monitor": "bunx snyk monitor",
    "security:fix": "bunx snyk fix",
    "security:wizard": "bunx snyk wizard",
    "snyk:setup": "bash scripts/snyk-setup.sh",
    "security:lockfile": "bun run scripts/check-lockfile.ts",
    "security:install": "bun install --frozen-lockfile",
    "security:audit": "bunx snyk test --severity-threshold=high",
    "security:scan": "bun run security:lockfile && bun run security:audit",
    "worker:webhook": "bun src/workers/webhookDeliveryWorker.ts",
    "worker:pdf": "bun src/workers/pdfReceiptWorker.ts",
    "worker:email": "bun src/workers/emailWorker.ts",
    "worker:cdc": "bun src/workers/cdcWorker.ts",
    "worker:all": "concurrently \"bun run worker:webhook\" \"bun run worker:pdf\" \"bun run worker:email\" \"bun run worker:cdc\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.901.0",
    "@aws-sdk/s3-request-presigner": "3.797.0",
    "@fastify/auth": "^5.0.4",
    "@fastify/caching": "^9.0.3",
    "@fastify/circuit-breaker": "^4.0.2",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/error": "^4.2.0",
    "@fastify/etag": "^6.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/otel": "^0.18.0",
    "@fastify/rate-limit": "^10.3.0",
